"""
环境配置文件
"""

# 复制此文件为 .env 并填入实际配置
# 复制命令: cp .env.example .env

# API密钥配置
# 通义千问API密钥
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 智谱GLM API密钥
ZHIPU_API_KEY=your_zhipu_api_key_here

# 基础配置
APP_NAME=红笔 · 教师单机自用版
VERSION=V0.4
DEBUG=True
HOST=0.0.0.0
PORT=8080

# 数据库配置
DATABASE_URL=sqlite:///./data/red_pen.db

# 安全配置
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI模型配置
DEFAULT_LLM_PROVIDER=qwen
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3
LLM_BACKOFF_FACTOR=1.0

# 文件上传配置
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

# 默认配置
DEFAULT_STAGE=小学
DEFAULT_SUBJECT=数学
DEFAULT_CLASS=默认班级